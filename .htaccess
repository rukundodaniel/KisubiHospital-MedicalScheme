Options -Indexes

# Block sensitive files from the web (install.php unblocked until you delete it)
<FilesMatch "^(config\.php|.*\.sqlite|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
  </IfModule>
</FilesMatch>
